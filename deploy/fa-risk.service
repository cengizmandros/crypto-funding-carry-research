[Unit]
Description=funding-arb paper: risk
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/funding-arb
Environment=FA_HOME=%h/funding-arb
ExecStart=%h/funding-arb/.venv/bin/python %h/funding-arb/scripts/paper_ctl.py risk
Nice=10
TimeoutStartSec=20min
